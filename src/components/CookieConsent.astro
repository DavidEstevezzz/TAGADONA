---
---
<section id="cookie-consent" class="cookie-consent" aria-label="Preferencias de cookies" hidden>
  <div class="cookie-consent__info">
    <strong>Cookies de analítica</strong>
    <p>Nos gustaría usar Google Analytics para conocer las visitas a la web y mejorarla. Solo lo activaremos si aceptas. Puedes cambiar tu elección cuando quieras desde «Configurar cookies».</p>
    <a href="/politica-de-cookies/">Más información sobre las cookies</a>
  </div>
  <div class="cookie-consent__actions">
    <button id="cookie-reject" type="button" class="cookie-consent__button cookie-consent__button--secondary">Rechazar</button>
    <button id="cookie-accept" type="button" class="cookie-consent__button cookie-consent__button--primary">Aceptar analítica</button>
  </div>
</section>

<style>
  .cookie-consent[hidden]{display:none!important}
  .cookie-consent{
    position:fixed;z-index:400;bottom:16px;left:16px;right:16px;
    max-width:920px;margin:auto;display:flex;justify-content:space-between;
    align-items:center;gap:24px;padding:20px 24px;
    color:var(--text);background:#221d1a;border:1px solid #4b392e;
    box-shadow:0 16px 50px rgba(0,0,0,.42);border-radius:6px;
  }
  .cookie-consent__info{max-width:620px}
  .cookie-consent__info strong{font-size:16px;font-weight:600}
  .cookie-consent__info p{font-size:13px;line-height:1.65;color:var(--text-dim);margin-top:5px}
  .cookie-consent__info a{display:inline-block;font-size:12px;color:var(--orange-bright);margin-top:8px;text-decoration:underline;text-underline-offset:3px}
  .cookie-consent__actions{display:flex;flex-shrink:0;gap:10px;align-items:center}
  .cookie-consent__button{font:600 13px 'Poppins',sans-serif;cursor:pointer;border-radius:3px;padding:12px 16px;min-height:44px}
  .cookie-consent__button--secondary{border:1px solid #776254;background:transparent;color:var(--text)}
  .cookie-consent__button--primary{border:1px solid var(--orange);background:var(--orange);color:#150f0b}
  .cookie-consent__button:hover{filter:brightness(1.12)}
  @media(max-width:710px){
    .cookie-consent{bottom:10px;left:10px;right:10px;padding:18px;flex-direction:column;align-items:stretch;gap:14px}
    .cookie-consent__actions{display:grid;grid-template-columns:1fr 1fr}
    .cookie-consent__button{padding:12px 9px}
  }
</style>

<script>
  // Modo de consentimiento básico: nunca se carga GTM/GA4 sin consentimiento.
  // La etiqueta G-XZRX950DDQ se configura DENTRO del contenedor GTM.
  const CONSENT_KEY = 'tagadona_analytics_consent_v1';
  const GTM_ID = 'GTM-PL9RNV5J';
  const panel = document.getElementById('cookie-consent');
  const openPreferences = document.getElementById('cookie-settings');
  let gtmLoaded = false;

  function getConsent() {
    try { return localStorage.getItem(CONSENT_KEY); }
    catch (_) { return null; }
  }

  function loadTagManager() {
    if (gtmLoaded) return;
    gtmLoaded = true;
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });

    const script = document.createElement('script');
    script.async = true;
    script.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(GTM_ID);
    script.dataset.tagadonaGtm = 'true';
    document.head.appendChild(script);
  }

  function chooseConsent(value) {
    const wasLoaded = gtmLoaded;
    try { localStorage.setItem(CONSENT_KEY, value); }
    catch (_) { /* El sitio funciona aunque el almacenamiento esté deshabilitado. */ }
    if (panel) panel.hidden = true;
    if (value === 'accepted') {
      loadTagManager();
    } else if (wasLoaded) {
      // El navegador no puede descargar una etiqueta ya ejecutada:
      // recargamos para asegurar que no se vuelve a cargar tras rechazar.
      window.location.reload();
    }
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => chooseConsent('accepted'));
  document.getElementById('cookie-reject')?.addEventListener('click', () => chooseConsent('rejected'));
  openPreferences?.addEventListener('click', () => {
    if (panel) {
      panel.hidden = false;
      document.getElementById('cookie-accept')?.focus();
    }
  });

  if (getConsent() === 'accepted') loadTagManager();
  else if (getConsent() !== 'rejected' && panel) panel.hidden = false;
</script>
